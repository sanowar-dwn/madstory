# ==============================================================================
# The Mad Story - Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Security Settings
# ------------------------------------------------------------------------------
# Generate a strong 50+ character random key in production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-strong-secret-key-in-production

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of domain names and IP addresses allowed to serve this app
DJANGO_ALLOWED_HOSTS=themadstory.com,www.themadstory.com,localhost,127.0.0.1,backend

# SSL & Security (Set to True if serving behind HTTPS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# SQLite is used by default in production with WAL concurrency optimizations.
# No DATABASE_URL is needed for SQLite! (Just leave DATABASE_URL blank or commented)
# Optional: custom path to sqlite database (defaults to backend/db.sqlite3)
# SQLITE_PATH=/home/username/madstory_backend/db.sqlite3

# If you ever want to switch to external PostgreSQL or MySQL:
# DATABASE_URL=postgres://madstory:password@localhost:5432/madstory
# DATABASE_URL=mysql://cpaneluser_dbuser:password@localhost/cpaneluser_db

# ------------------------------------------------------------------------------
# Redis Cache & Broker Settings
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# CORS & CSRF Trusted Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins in production
CORS_ALLOWED_ORIGINS=https://themadstory.com,https://www.themadstory.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://themadstory.com,https://www.themadstory.com,http://localhost:5173

# ------------------------------------------------------------------------------
# API Rate Limiting (Throttling)
# ------------------------------------------------------------------------------
THROTTLE_ANON_RATE=200/day
THROTTLE_USER_RATE=2000/day

# ------------------------------------------------------------------------------
# Cloudflare R2 Media Storage (S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
# When filled, all uploaded media (article covers, editor images, banners) are
# automatically sent to your Cloudflare R2 bucket.
# If omitted, Django automatically falls back to local media filesystem.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=madstory-media
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.themadstory.com

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
